# Environment Configuration
# Copy this file to .env.local and fill in your actual values

# =============================================================================
# VERCEL DEPLOYMENT SETTINGS
# =============================================================================

# Environment (development, staging, production)
NODE_ENV=development

# Application URL (set by Vercel automatically in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# BLOCKCHAIN CONFIGURATION
# =============================================================================

# Ethereum RPC URLs
NEXT_PUBLIC_ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID
NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon-mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Testnet RPC URLs (for development)
NEXT_PUBLIC_GOERLI_RPC_URL=https://goerli.infura.io/v3/YOUR_INFURA_PROJECT_ID
NEXT_PUBLIC_MUMBAI_RPC_URL=https://polygon-mumbai.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Contract Addresses (deployed smart contracts)
NEXT_PUBLIC_CIVIC_TRUST_CONTRACT=0x...
NEXT_PUBLIC_GOVERNANCE_CONTRACT=0x...
NEXT_PUBLIC_VOTING_CONTRACT=0x...

# WalletConnect Project ID
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database URL (if using database)
DATABASE_URL=postgresql://username:password@localhost:5432/civictrust

# MongoDB URL (alternative database option)
MONGODB_URL=mongodb://localhost:27017/civictrust

# Redis URL (for caching and sessions)
REDIS_URL=redis://localhost:6379

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# NextAuth.js Secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your_nextauth_secret_here

# JWT Secret
JWT_SECRET=your_jwt_secret_here

# Session Secret
SESSION_SECRET=your_session_secret_here

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Error Tracking (Sentry)
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# Email Service (SendGrid, Mailgun, etc.)
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@civictrust.app

# IPFS (for decentralized file storage)
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_API_KEY=your_pinata_secret_key

# =============================================================================
# MONITORING & LOGGING
# =============================================================================

# Application Performance Monitoring
VERCEL_ANALYTICS_ID=your_vercel_analytics_id

# LogRocket (user session recordings)
NEXT_PUBLIC_LOGROCKET_APP_ID=your_logrocket_app_id

# =============================================================================
# SOCIAL MEDIA & SHARING
# =============================================================================

# Open Graph Images
NEXT_PUBLIC_OG_IMAGE_URL=https://civictrust.vercel.app/og-image.jpg

# Social Media Links
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/civictrust
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/civictrust
NEXT_PUBLIC_GITHUB_URL=https://github.com/civictrust

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable/disable features
NEXT_PUBLIC_ENABLE_WALLET_CONNECT=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_ERROR_TRACKING=true
NEXT_PUBLIC_ENABLE_BETA_FEATURES=false

# =============================================================================
# RATE LIMITING
# =============================================================================

# API Rate Limits
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://civictrust.vercel.app